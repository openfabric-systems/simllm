      "minimum_peer_port_rate",
      "minimum_transport_rate",
      "maximum_host_launch_ps",
      "maximum_device_fixed_ps",
      "maximum_transport_fixed_ps_per_action"
    ],
    "floor_side_fields": [
      "flops",
      "hbm_bytes",
      "peer_bytes",
      "maximum_compute_rate",
      "maximum_hbm_rate",
      "maximum_peer_port_rate",
      "kernel_floor_ps_by_implementation",
      "applicable_stages",
      "dependency_edges"
    ],
    "rate_rule": "minimum-and-maximum-rates-are-positive-reduced-rationals-in-declared-base-units-per-second",
    "fixed_rule": "maximum-fixed-terms-and-kernel-floor-values-are-nonnegative-integer-picoseconds",
    "evidence_rule": "every-ceiling-side-and-floor-side-field-cites-preexisting-qualified-evidence-and-never-the-current-cell-outcome",
    "lineage_rule": "reject-any-field-whose-direct-or-transitive-evidence-lineage-includes-a-timing-or-result-from-the-cell-it-bounds",
    "target_rule": "every-rate-and-kernel-floor-row-matches-the-exact-target-architecture-and-operating-envelope-or-the-cell-is-blocked-before-observation",
    "missing_floor_rule": "a-missing-or-unqualified-floor-side-field-blocks-the-cell-before-any-timing-is-read"

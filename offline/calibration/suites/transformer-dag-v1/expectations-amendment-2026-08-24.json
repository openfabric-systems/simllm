  "term_definitions": {
    "flops": "the-stage-authored-nonnegative-floating-point-operation-count",
    "hbm_bytes": "the-stage-authored-nonnegative-compulsory-hbm-byte-count",
    "peer_bytes": "the-stage-authored-nonnegative-directional-peer-port-byte-count-charged-once",
    "picoseconds_per_second": "the-exact-integer-1000000000000",
    "maximum_compute_rate_num": "the-positive-numerator-of-the-preexisting-qualified-maximum-compute-rate",
    "maximum_compute_rate_den": "the-positive-denominator-of-the-preexisting-qualified-maximum-compute-rate",
    "maximum_hbm_rate_num": "the-positive-numerator-of-the-preexisting-qualified-maximum-hbm-rate",
    "maximum_hbm_rate_den": "the-positive-denominator-of-the-preexisting-qualified-maximum-hbm-rate",
    "maximum_peer_port_rate_num": "the-positive-numerator-of-the-preexisting-qualified-maximum-directional-peer-port-rate",
    "maximum_peer_port_rate_den": "the-positive-denominator-of-the-preexisting-qualified-maximum-directional-peer-port-rate",
    "compute_floor_ps": "the-EQ2-compute-throughput-floor-for-one-applicable-stage",
    "memory_floor_ps": "the-EQ3-compulsory-hbm-serialization-floor-for-one-applicable-stage",
    "peer_floor_ps": "the-EQ4-directional-peer-port-serialization-floor-for-one-applicable-stage",
    "kernel_floor_ps": "zero-for-a-nonkernel-stage-otherwise-the-exact-target-and-implementation-matched-nonnegative-fixed-per-kernel-floor-owned-by-COMP-43-and-obtained-from-preexisting-nonvoid-qualified-evidence",
    "isolated_floor_ps": "the-EQ5-maximum-applicable-independent-floor-for-one-stage",
    "applicable_stages": "the-preobservation-authored-stage-set-for-the-cell-with-each-stage-resolved-to-one-exact-implementation",
    "dependency_edges": "the-preobservation-authored-acyclic-dependency-edges-among-applicable-stages",
    "applicable_stage_floors_ps": "the-EQ5A-map-with-one-isolated_floor_ps-value-for-every-and-only-applicable-stage",
    "graph_floor_ps": "the-EQ6-longest-dependency-path-sum-through-the-applicable-stage-floor-map"
  },
  "operator_definitions": {
    "ceil": "least-integer-greater-than-or-equal-to-the-exact-rational-argument",
    "max": "greatest-exact-integer-argument",
    "map_applicable_stages": "apply-EQ2-through-EQ5-once-to-each-applicable-stage-and-preserve-stage-identity",
    "longest_dependency_path_sum": "maximum-over-all-directed-dependency-paths-of-the-sum-of-each-visited-stage-floor-exactly-once"
  },
  "replacement_equations": [
    {
      "id": "EQ2",
      "name": "compute-floor",
      "inputs": [
        "flops",
        "maximum_compute_rate_num",
        "maximum_compute_rate_den",
        "picoseconds_per_second"
      ],
      "outputs": [
        "compute_floor_ps"
      ],
      "operators": [
        "ceil"
      ],
      "expression": "compute_floor_ps = ceil(flops * maximum_compute_rate_den * picoseconds_per_second / maximum_compute_rate_num)"
    },
    {
      "id": "EQ3",
      "name": "memory-floor",
      "inputs": [
        "hbm_bytes",
        "maximum_hbm_rate_num",
        "maximum_hbm_rate_den",
        "picoseconds_per_second"
      ],
      "outputs": [
        "memory_floor_ps"
      ],
      "operators": [
        "ceil"
      ],
      "expression": "memory_floor_ps = ceil(hbm_bytes * maximum_hbm_rate_den * picoseconds_per_second / maximum_hbm_rate_num)"
    },
    {
      "id": "EQ4",
      "name": "peer-floor",
      "inputs": [
        "peer_bytes",
        "maximum_peer_port_rate_num",
        "maximum_peer_port_rate_den",
        "picoseconds_per_second"
      ],
      "outputs": [
        "peer_floor_ps"
      ],
      "operators": [
        "ceil"
      ],
      "expression": "peer_floor_ps = ceil(peer_bytes * maximum_peer_port_rate_den * picoseconds_per_second / maximum_peer_port_rate_num)"
    },
    {
      "id": "EQ5",
      "name": "isolated-floor",
      "inputs": [
        "compute_floor_ps",
        "memory_floor_ps",
        "peer_floor_ps",
        "kernel_floor_ps"
      ],
      "outputs": [
        "isolated_floor_ps"
      ],
      "operators": [
        "max"
      ],
      "expression": "isolated_floor_ps = max(compute_floor_ps, memory_floor_ps, peer_floor_ps, kernel_floor_ps)"
    },
    {
      "id": "EQ5A",
      "name": "applicable-stage-floors",
      "inputs": [
        "applicable_stages",
        "isolated_floor_ps"
      ],
      "outputs": [
        "applicable_stage_floors_ps"
      ],
      "operators": [
        "map_applicable_stages"
      ],
      "expression": "applicable_stage_floors_ps = map_applicable_stages(applicable_stages, isolated_floor_ps)"
    },
    {
      "id": "EQ6",
      "name": "graph-floor",
      "inputs": [
        "dependency_edges",
        "applicable_stage_floors_ps"
      ],
      "outputs": [
        "graph_floor_ps"
      ],
      "operators": [
        "longest_dependency_path_sum"
      ],
      "expression": "graph_floor_ps = longest_dependency_path_sum(dependency_edges, applicable_stage_floors_ps)"
    }
  ],
  "replacement_fatal_guard": {
    "id": "G11",
    "name": "pass-separation",
    "passes": [
      "timeline",
      "counter",
      "dynamic-instruction",
      "mixed"
    ],
    "claim": "Timeline, counter, dynamic-instruction and mixed passes remain separate; counter replay is never used as the concurrency timeline, and no pass output substitutes for another pass's evidence."
  },

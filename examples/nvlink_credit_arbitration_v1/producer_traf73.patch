+__global__ void traf73_start_kernel(unsigned long long* start_cycle,
+                                    volatile int* start_flag) {
+  if (blockIdx.x == 0 && threadIdx.x == 0) {
+    while (*start_flag == 0) {
+    }
+    *start_cycle = clock64();
+    __threadfence();
+  }
+}
+
+__global__ void traf73_ring_stream_kernel(
+    unsigned char* destination,
+    const unsigned char* source,
+    unsigned long long* order,
+    unsigned long long* completion_cycles,
+    const unsigned long long* start_cycle,
+    std::uint64_t ring_bytes,
+    std::uint64_t wire_bytes_per_chunk,
+    std::uint64_t chunk_count,
+    int offered_rate_percent,
+    int clock_rate_khz) {
+  const auto pacing_start = *start_cycle;
+  for (std::uint64_t chunk = blockIdx.x; chunk < chunk_count;
+       chunk += gridDim.x) {
+    const double target_ns =
+        static_cast<double>(chunk * wire_bytes_per_chunk) /
+        static_cast<double>(offered_rate_percent);
+    const auto target_cycles = static_cast<unsigned long long>(
+        target_ns * static_cast<double>(clock_rate_khz) / 1.0e6);
+    while (clock64() - pacing_start < target_cycles) {
+    }
+    for (std::uint64_t offset = threadIdx.x; offset < ring_bytes;
+         offset += blockDim.x) {
+      destination[offset] = source[offset];
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+      order[chunk] = chunk + 1;
+      completion_cycles[chunk] = clock64();
+    }
+    __syncthreads();
+  }
+}

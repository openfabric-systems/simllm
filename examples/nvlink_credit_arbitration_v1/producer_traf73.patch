+
+void write_double_matrix(
+    std::ofstream& output,
+    const std::vector<std::vector<double>>& values) {
+  output << '[';
+  for (std::size_t index = 0; index < values.size(); ++index) {
+    if (index) output << ',';
+    write_numeric_vector(output, values[index]);
+  }
+  output << ']';
+}

+CapturedObservation run_traf73_latency(const Point& point,
+                                       HardwareContext& context) {
+  if (point.producer != "persistent_sm_peer_write" || point.stream_count != 1 ||
+      point.stride != 1) {
+    throw std::runtime_error("TRAF-73 latency mode requires the persistent write identity controls");
+  }
+  const auto flows = flows_for(point);
+  const auto timed = static_cast<std::uint64_t>(point.traf73_timed_repetitions);
+  const auto warmups = static_cast<std::uint64_t>(point.traf73_warmup_repetitions);
+  const std::uint64_t span_per_flow = point.payload_bytes + 512;
+  if (span_per_flow * flows.size() > HardwareContext::kAllocationBytes ||
+      timed * flows.size() > HardwareContext::kOrderEntries) {
+    throw std::runtime_error("TRAF-73 latency point exceeds the fixed producer allocation");
+  }
+
+  std::vector<std::vector<unsigned char>> expected(flows.size());
+  for (std::size_t flow_index = 0; flow_index < flows.size(); ++flow_index) {
+    expected[flow_index].resize(span_per_flow);
+    for (std::uint64_t offset = 0; offset < point.payload_bytes; ++offset) {
+      expected[flow_index][point.source_alignment + offset] =
+          expected_byte(0, offset, flow_index);
+    }
+    const auto [source, destination] = flows[flow_index];
+    const auto region = flow_index * span_per_flow;
+    CUDA_CHECK(cudaSetDevice(source));
+    CUDA_CHECK(cudaMemcpy(context.buffers[source] + region,
+                          expected[flow_index].data(), span_per_flow,
+                          cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaSetDevice(destination));
+    CUDA_CHECK(cudaMemset(context.buffers[destination] + region, 0,
+                          span_per_flow));
+    CUDA_CHECK(cudaMemset(context.orders[destination] + flow_index * timed, 0,
+                          timed * sizeof(unsigned long long)));
+  }
+  for (int device = 0; device < 4; ++device) {
+    CUDA_CHECK(cudaSetDevice(device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+  }
+
+  const auto launch_copy = [&](std::size_t flow_index) {
+    const auto [source, destination] = flows[flow_index];
+    const auto region = flow_index * span_per_flow;
+    auto stream = context.streams[source][destination][0];
+    CUDA_CHECK(cudaSetDevice(source));
+    const int blocks = std::min(256, std::max(1, point.outstanding));
+    peer_copy_kernel<<<blocks, 256, 0, stream>>>(
+        context.buffers[destination] + region + point.destination_alignment,
+        context.buffers[source] + region + point.source_alignment,
+        context.orders[destination] + flow_index * timed,
+        point.payload_bytes, point.payload_bytes, point.access_width, 1,

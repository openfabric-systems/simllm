+template <typename Value>
+void write_numeric_vector(std::ofstream& output,
+                          const std::vector<Value>& values) {
+  output << '[';
+  for (std::size_t index = 0; index < values.size(); ++index) {
+    if (index) output << ',';
+    output << values[index];
+  }
+  output << ']';

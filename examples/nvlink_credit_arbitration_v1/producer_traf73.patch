+CapturedObservation run_traf73_steady(const Point& point,
+                                      HardwareContext& context) {
+  if (point.producer != "persistent_sm_peer_write" || point.stride != 1 ||
+      point.stream_count != 1) {
+    throw std::runtime_error("TRAF-73 steady mode requires the persistent write identity controls");
+  }
+  const auto flows = flows_for(point);
+  const auto rates = traf73_flow_rates(point, flows.size());
+  const auto ring_bytes = point.traf73_ring_bytes;
+  const auto offered_ms = point.traf73_window_warmup_ms +
+                          point.traf73_window_measurement_ms +
+                          point.traf73_window_drain_ms;
+  if (ring_bytes * flows.size() > HardwareContext::kAllocationBytes) {
+    throw std::runtime_error("TRAF-73 steady rings exceed the fixed producer allocation");
+  }
+
+  std::vector<std::uint64_t> chunk_counts;
+  for (const int rate : rates) {
+    const double offered_raw_bytes = static_cast<double>(rate) * 1.0e9 *
+                                     static_cast<double>(offered_ms) / 1000.0;
+    chunk_counts.push_back(
+        static_cast<std::uint64_t>(
+            std::ceil(offered_raw_bytes / traf73_wire_bytes(ring_bytes))));
+  }
+  if (*std::max_element(chunk_counts.begin(), chunk_counts.end()) * 2 + 1 >
+      HardwareContext::kOrderEntries) {
+    throw std::runtime_error("TRAF-73 steady ledgers exceed the fixed producer allocation");
+  }
+
+  std::vector<std::vector<unsigned char>> expected(flows.size());
+  for (std::size_t flow_index = 0; flow_index < flows.size(); ++flow_index) {
+    expected[flow_index].resize(ring_bytes);
+    for (std::uint64_t offset = 0; offset < ring_bytes; ++offset) {
+      expected[flow_index][offset] = expected_byte(0, offset, flow_index);
+    }
+    const auto [source, destination] = flows[flow_index];
+    const auto region = flow_index * ring_bytes;
+    CUDA_CHECK(cudaSetDevice(source));
+    CUDA_CHECK(cudaMemcpy(context.buffers[source] + region,
+                          expected[flow_index].data(), ring_bytes,
+                          cudaMemcpyHostToDevice));
+    CUDA_CHECK(cudaMemset(context.orders[source], 0,
+                          (chunk_counts[flow_index] * 2 + 1) *
+                              sizeof(unsigned long long)));
+    CUDA_CHECK(cudaSetDevice(destination));
+    CUDA_CHECK(cudaMemset(context.buffers[destination] + region, 0, ring_bytes));
+  }
+  for (int device = 0; device < 4; ++device) {
+    CUDA_CHECK(cudaSetDevice(device));
+    CUDA_CHECK(cudaDeviceSynchronize());
+  }
+
+  int* host_start_flag = nullptr;
+  int* device_start_flag = nullptr;
+  CUDA_CHECK(cudaHostAlloc(&host_start_flag, sizeof(int),
+                           cudaHostAllocMapped | cudaHostAllocPortable));
+  *host_start_flag = 0;
+  CUDA_CHECK(cudaHostGetDevicePointer(&device_start_flag, host_start_flag, 0));
+
+  auto telemetry_before = capture_telemetry(context);
+  const auto counters_before = capture_links(context);
+  std::vector<std::chrono::steady_clock::time_point> launch_times(flows.size());
+  std::vector<cudaEvent_t> active_events(flows.size());
+  for (std::size_t flow_index = 0; flow_index < flows.size(); ++flow_index) {
+    const auto [source, destination] = flows[flow_index];
+    const auto count = chunk_counts[flow_index];
+    const auto region = flow_index * ring_bytes;
+    auto stream = context.streams[source][destination][0];
+    CUDA_CHECK(cudaSetDevice(source));
+    launch_times[flow_index] = std::chrono::steady_clock::now();
+    traf73_start_kernel<<<1, 1, 0, stream>>>(
+        context.orders[source] + 2 * count, device_start_flag);
+    CUDA_CHECK(cudaGetLastError());
+    CUDA_CHECK(cudaEventCreate(&active_events[flow_index]));
+    CUDA_CHECK(cudaEventRecord(active_events[flow_index], stream));
+    traf73_ring_stream_kernel<<<
+        static_cast<unsigned int>(std::min<std::uint64_t>(256, count)), 256, 0,
+        stream>>>(context.buffers[destination] + region,
+                  context.buffers[source] + region, context.orders[source],
+                  context.orders[source] + count,
+                  context.orders[source] + 2 * count,
+                  ring_bytes, traf73_wire_bytes(ring_bytes), count,
+                  rates[flow_index],
+                  context.clock_rate_khz[source]);
+    CUDA_CHECK(cudaGetLastError());
+  }
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+  *host_start_flag = 1;
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+
+  for (std::size_t flow_index = 0; flow_index < flows.size(); ++flow_index) {
+    CUDA_CHECK(cudaSetDevice(flows[flow_index].first));
+    CUDA_CHECK(cudaEventSynchronize(active_events[flow_index]));
+    CUDA_CHECK(cudaEventDestroy(active_events[flow_index]));
+  }
+  const auto common_started = std::chrono::steady_clock::now();
+  const auto window_target =
+      common_started + std::chrono::milliseconds(point.traf73_window_warmup_ms);
+  std::this_thread::sleep_until(window_target);
+  const auto window_counters_before = capture_links(context);
+  const auto window_started = std::chrono::steady_clock::now();
+  const auto window_completed_target =
+      window_started + std::chrono::milliseconds(point.traf73_window_measurement_ms);
+  std::this_thread::sleep_until(window_completed_target);
+  const auto window_counters_after = capture_links(context);
+  const auto window_completed = std::chrono::steady_clock::now();
+  std::this_thread::sleep_until(
+      window_completed + std::chrono::milliseconds(point.traf73_window_drain_ms));
+  for (std::size_t flow_index = 0; flow_index < flows.size(); ++flow_index) {
+    CUDA_CHECK(cudaSetDevice(flows[flow_index].first));
+    CUDA_CHECK(cudaStreamSynchronize(
+        context.streams[flows[flow_index].first][flows[flow_index].second][0]));
+  }
+  const auto counters_after = capture_links(context);
+  auto telemetry_after = capture_telemetry(context);
+  CUDA_CHECK(cudaFreeHost(host_start_flag));
+
+  CapturedObservation captured;
+  captured.links = link_deltas(counters_before, counters_after);
+  captured.traf73_window_links =
+      link_deltas(window_counters_before, window_counters_after);
+  captured.telemetry_before = std::move(telemetry_before);
+  captured.telemetry_after = std::move(telemetry_after);
+  captured.summary.traf73_mode = "steady_arbitration";
+  captured.summary.traf73_flow_offered_rate_percents = rates;
+  captured.summary.traf73_host_window_us =
+      std::chrono::duration<double, std::micro>(window_completed - window_started)
+          .count();
+  const auto launch_bounds = std::minmax_element(launch_times.begin(), launch_times.end());
+  captured.summary.traf73_launch_skew_us =
+      std::chrono::duration<double, std::micro>(*launch_bounds.second -
+                                                *launch_bounds.first)
+          .count();
+  captured.summary.flow_completion_us.resize(flows.size());
+  captured.summary.traf73_window_device_us_by_flow.resize(flows.size());
+  captured.summary.traf73_window_completed_bytes_by_flow.resize(flows.size());
+  captured.summary.flow_logical_bytes.resize(flows.size());
+
+  traf70::Sha256 expected_digest;
+  traf70::Sha256 observed_digest;
+  traf70::Sha256 expected_order_digest;
+  traf70::Sha256 observed_order_digest;
+  for (std::size_t flow_index = 0; flow_index < flows.size(); ++flow_index) {
+    const auto [source, destination] = flows[flow_index];
+    const auto count = chunk_counts[flow_index];
+    const auto region = flow_index * ring_bytes;
+    std::vector<unsigned char> observed(ring_bytes);
+    std::vector<unsigned long long> order(count);
+    std::vector<unsigned long long> completions(count);
+    unsigned long long start_cycle = 0;
+    CUDA_CHECK(cudaSetDevice(destination));
+    CUDA_CHECK(cudaMemcpy(observed.data(), context.buffers[destination] + region,
+                          ring_bytes, cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaSetDevice(source));
+    CUDA_CHECK(cudaMemcpy(order.data(), context.orders[source],
+                          count * sizeof(unsigned long long), cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemcpy(completions.data(), context.orders[source] + count,
+                          count * sizeof(unsigned long long), cudaMemcpyDeviceToHost));
+    CUDA_CHECK(cudaMemcpy(&start_cycle, context.orders[source] + 2 * count,
+                          sizeof(start_cycle), cudaMemcpyDeviceToHost));
+    const auto measurement_start =
+        start_cycle + static_cast<unsigned long long>(
+                          point.traf73_window_warmup_ms) *
+                          context.clock_rate_khz[source];
+    const auto measurement_end =
+        measurement_start + static_cast<unsigned long long>(
+                                point.traf73_window_measurement_ms) *
+                                context.clock_rate_khz[source];
+    const auto completed_chunks = static_cast<std::uint64_t>(std::count_if(
+        completions.begin(), completions.end(), [&](unsigned long long cycle) {
+          return cycle >= measurement_start && cycle < measurement_end;
+        }));
+    captured.summary.traf73_window_completed_bytes_by_flow[flow_index] =
+        completed_chunks * ring_bytes;
+    captured.summary.traf73_window_device_us_by_flow[flow_index] =
+        static_cast<double>(measurement_end - measurement_start) /
+        context.clock_rate_khz[source] * 1000.0;
+    captured.summary.flow_logical_bytes[flow_index] = count * ring_bytes;
+    captured.summary.logical_bytes += count * ring_bytes;
+    captured.summary.expected_extents += count;
+    captured.summary.flow_completion_us[flow_index] =
+        completions.empty()
+            ? 0.0
+            : static_cast<double>(
+                  *std::max_element(completions.begin(), completions.end()) -
+                  start_cycle) /
+                  context.clock_rate_khz[source] * 1000.0;
+    for (std::uint64_t offset = 0; offset < ring_bytes; ++offset) {
+      const auto expected_value = expected_byte(0, offset, flow_index);
+      expected_digest.update(&expected_value, 1);
+      observed_digest.update(&observed[offset], 1);
+    }
+    for (std::uint64_t chunk = 0; chunk < count; ++chunk) {
+      const std::uint64_t expected_value = chunk + 1;
+      expected_order_digest.update(&expected_value, sizeof(expected_value));
+      observed_order_digest.update(&order[chunk], sizeof(order[chunk]));
+      if (order[chunk] == 0 || completions[chunk] == 0) ++captured.summary.missing;
+      if (order[chunk] != 0 && order[chunk] != expected_value) {
+        ++captured.summary.out_of_order;
+      }
+    }
+  }
+  captured.summary.expected_sha256 = expected_digest.finish_hex();
+  captured.summary.observed_sha256 = observed_digest.finish_hex();
+  captured.summary.expected_sequence_sha256 = expected_order_digest.finish_hex();
+  captured.summary.observed_sequence_sha256 = observed_order_digest.finish_hex();
+  captured.summary.terminal_extents =
+      captured.summary.expected_extents - captured.summary.missing;
+  captured.summary.elapsed_us = *std::max_element(
+      captured.summary.flow_completion_us.begin(),
+      captured.summary.flow_completion_us.end());
+  captured.summary.completion_us = captured.summary.elapsed_us;
+  captured.summary.drain_us = std::max(
+      0.0,
+      captured.summary.elapsed_us -
+          static_cast<double>(point.traf73_window_warmup_ms +
+                              point.traf73_window_measurement_ms) *
+              1000.0);
+  captured.summary.protocol = "traf73_steady_window_observation";
+  set_observed_counter_totals(captured);
+  set_hardware_throttle_verdict(captured);
+  return captured;
+}

      "sglang_inter_token_latency",
      "sglang_output_cost",
      "sglang_prefill_delta",
      "sglang_mtp_decode_delta",
      "deepseek_production_prefill",
      "deepseek_production_decode"
    ],
    "rule": "a fitted constant may read only calibration_anchor_ids; scoring may read only held_out_anchor_ids; rounded, ranged, cost, comparison, and second-legend values remain context-only"
  },
